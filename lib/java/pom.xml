<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>dev.pathland</groupId>
    <artifactId>pathland-parent</artifactId>
    <version>0.2.2</version>
    <packaging>pom</packaging>

    <name>Pathland Java</name>
    <description>
        Framework-agnostic JVM libraries for the Pathland UI protocol: a pure-Java
        opcode/wire core (16-byte opcodes, PLPL frame codec, attributed text,
        Markdown), a Kotlin engine + authoring DSL with Angular-style
        signals/computed/effects, a reusable HTML renderer, and cross-platform
        state stores (in-memory by default; the opt-in pathland-state-redis module
        adds Lettuce/Redis). Native desktop hosts use the opt-in JNA ring interop in
        pathland-native-core. Java hosts (Spring Boot, Quarkus, desktop) mount
        Kotlin-authored views. Runs on every LTS from Java 17.
    </description>

    <url>https://github.com/PathlandDev/Pathland</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>michaelkrog</id>
            <name>Michael Krog</name>
            <email>mic@apaq.dk</email>
            <url>https://github.com/michaelkrog</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/PathlandDev/Pathland.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/PathlandDev/Pathland.git</developerConnection>
        <url>https://github.com/PathlandDev/Pathland</url>
        <tag>HEAD</tag>
    </scm>

    <!-- The publishable JVM libraries and server starters. The demo applications
         (and the demo-only views library) are added by the default-active
         `demos` profile below, so activating any other profile — `release`,
         `refresh-ide`, or `jvm-only` — leaves a demo-free reactor. -->
    <modules>
        <module>pathland-core</module>
        <module>pathland-view-core</module>
        <module>pathland-native-core</module>
        <module>pathland-render-html</module>
        <module>pathland-server-core</module>
        <module>pathland-state-redis</module>
        <module>pathland-spring-boot-starter</module>
        <module>pathland-quarkus</module>
        <module>pathland-quarkus-deployment</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Whole-stack floor: every LTS from Java 17. ScopedValue was replaced with a
             thread-local environment and the FFM ring interop with JNA (isolated in
             pathland-native-core) to achieve this. -->
        <maven.compiler.release>17</maven.compiler.release>
        <kotlin.version>2.4.10</kotlin.version>
        <jna.version>5.14.0</jna.version>
        <quarkus.version>3.39.1</quarkus.version>
        <spring-boot.version>3.5.16</spring-boot.version>
        <!-- Kotlin modules use Dokka to build the Central-required -javadoc.jar;
             JDK javadoc cannot resolve Kotlin declarations from Java sources. -->
        <dokka.version>2.3.0</dokka.version>
        <!-- Registers `src/main/kotlin` as a compile source root so the Central
             sources jar (maven-source-plugin jar-no-fork archives the compile
             source roots) includes Kotlin sources, not just `src/main/java`.
             Kotlin 2.4 removed the kotlin-maven-plugin add-source goal. -->
        <build-helper.version>3.6.1</build-helper.version>
        <junit.version>5.10.2</junit.version>
        <lettuce.version>6.4.1.RELEASE</lettuce.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>net.java.dev.jna</groupId>
                <artifactId>jna</artifactId>
                <version>${jna.version}</version>
            </dependency>
            <dependency>
                <groupId>io.lettuce</groupId>
                <artifactId>lettuce-core</artifactId>
                <version>${lettuce.version}</version>
            </dependency>
            <dependency>
                <groupId>io.quarkus</groupId>
                <artifactId>quarkus-bom</artifactId>
                <version>${quarkus.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <!-- The Java DSL and its integrations are removed: keep them out. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>ban-removed-java-dsl</id>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>dev.pathland:pathland-view</exclude>
                                        <exclude>dev.pathland:pathland-view-processor</exclude>
                                        <exclude>dev.pathland:pathland-quarkus-java</exclude>
                                        <exclude>dev.pathland:pathland-quarkus-starter</exclude>
                                    </excludes>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.2.5</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>3.3.1</version>
                    <configuration>
                        <!-- Re-copy static resources (e.g. the rebuilt
                             content-hashed dom-renderer bundle and its
                             dom-renderer.current manifest) over existing target
                             files instead of failing with FileAlreadyExistsException
                             on repeat builds. -->
                        <overwrite>true</overwrite>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>build-helper-maven-plugin</artifactId>
                    <version>${build-helper.version}</version>
                </plugin>
                <plugin>
                    <groupId>io.quarkus</groupId>
                    <artifactId>quarkus-maven-plugin</artifactId>
                    <version>${quarkus.version}</version>
                </plugin>
                <plugin>
                    <groupId>io.quarkus</groupId>
                    <artifactId>quarkus-extension-maven-plugin</artifactId>
                    <version>${quarkus.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>3.5.0</version>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <!-- The JVM libraries are pure JVM: no Rust toolchain or cargo build is part of
         `mvn test`, `mvn package`, or the Maven Central release. Rust is only needed
         for the native desktop demos (scripts/lib.sh builds `libpathland_core` and the
         GTK/Qt renderer dylibs) and for regenerating shared artifacts (the protocol
         manifest, engine traces, HTML golden fixtures, and TS constants).

         Run BEFORE an IntelliJ IDE run: refreshes the generated layers the IDE cannot
         rebuild itself — the design CSS/tokens (npm build) and the DOM bundle
         (npm build:all) — plus the render-html module's embedded CSS resources (its
         Maven copy step does not run under IntelliJ's own build). IntelliJ then
         compiles the Java modules from its module outputs (the pathland modules are
         imported, so no ~/.m2 is used) and copies the refreshed bundle + its
         dom-renderer.current manifest into target/classes on Build Project. Invoke with
         `mvn -P refresh-ide validate`, then Reload All Maven Projects → Build → Run →
         reload. The bundle is content-hashed (dom-renderer-<sha256>.js) so a rebuilt
         bundle busts the immutable asset cache by URL — a normal reload after restart
         is enough, no hard refresh. -->
    <profiles>
    <!-- Default reactor: the libraries plus the demo applications. Maven deactivates
         an activeByDefault profile as soon as any other profile in this POM is
         activated, so `-P release`, `-P refresh-ide`, and `-P jvm-only` all leave a
         demo-free reactor. -->
    <profile>
        <id>demos</id>
        <activation>
            <activeByDefault>true</activeByDefault>
        </activation>
        <modules>
            <module>pathland-demo-views-kotlin</module>
            <module>pathland-desktop-demo</module>
            <module>pathland-quarkus-demo</module>
            <module>pathland-spring-boot-demo</module>
        </modules>
    </profile>
    <!-- `mvn -Pjvm-only test`: the JVM libraries and server starters only. Activating
         this profile deactivates the default-active `demos` profile, so no demo
         modules are in the reactor. The JVM libraries never required Rust. -->
    <profile>
        <id>jvm-only</id>
        <properties>
            <pathland.jvm-only>true</pathland.jvm-only>
        </properties>
    </profile>
    <!-- Maven Central publishing (`mvn -P release deploy`). Normal builds/tests are
         unaffected: this profile only activates on demand. Because it is active, the
         default `demos` profile is off and the reactor contains only publishable
         modules. -->
    <profile>
        <id>release</id>
        <build>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-source-plugin</artifactId>
                    <version>3.3.1</version>
                    <executions>
                        <execution>
                            <id>attach-sources</id>
                            <goals><goal>jar-no-fork</goal></goals>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <version>3.6.3</version>
                    <configuration>
                        <!-- Central requires a -javadoc jar; disable strict doclint so
                             existing doc comments don't fail the release build.
                             Don't link to reactor siblings' apidocs: pathland-view-core
                             builds its javadoc with Dokka, so target/apidocs does not
                             exist and javadoc logs "Error fetching link" noise. -->
                        <doclint>none</doclint>
                        <detectOfflineLinks>false</detectOfflineLinks>
                    </configuration>
                    <executions>
                        <execution>
                            <id>attach-javadocs</id>
                            <goals><goal>jar</goal></goals>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-gpg-plugin</artifactId>
                    <version>3.2.4</version>
                    <executions>
                        <execution>
                            <id>sign-artifacts</id>
                            <phase>verify</phase>
                            <goals><goal>sign</goal></goals>
                        </execution>
                    </executions>
                </plugin>
                <!-- Uploads the whole reactor to the Sonatype Central Portal as one
                     deployment (auto-published after validation). Credentials come
                     from the `central` server in ~/.m2/settings.xml. -->
                <plugin>
                    <groupId>org.sonatype.central</groupId>
                    <artifactId>central-publishing-maven-plugin</artifactId>
                    <version>0.6.0</version>
                    <extensions>true</extensions>
                    <configuration>
                        <publishingServerId>central</publishingServerId>
                        <autoPublish>true</autoPublish>
                    </configuration>
                </plugin>
            </plugins>
        </build>
    </profile>
    <profile>
        <id>refresh-ide</id>
        <build>
            <plugins>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>exec-maven-plugin</artifactId>
                    <version>3.1.0</version>
                    <!-- Runs ONLY at the aggregator (parent); the refresh steps must
                         not repeat once per child module. -->
                    <inherited>false</inherited>
                    <executions>
                        <execution>
                            <id>refresh-design</id>
                            <phase>validate</phase>
                            <goals><goal>exec</goal></goals>
                            <configuration>
                                <workingDirectory>${session.executionRootDirectory}/../../design</workingDirectory>
                                <executable>npm</executable>
                                <arguments>
                                    <argument>run</argument>
                                    <argument>build</argument>
                                </arguments>
                            </configuration>
                        </execution>
                        <execution>
                            <id>refresh-design-sync</id>
                            <phase>validate</phase>
                            <goals><goal>exec</goal></goals>
                            <configuration>
                                <workingDirectory>${session.executionRootDirectory}/../..</workingDirectory>
                                <executable>${session.executionRootDirectory}/../../scripts/sync-design-css.sh</executable>
                            </configuration>
                        </execution>
                        <execution>
                            <id>refresh-ts</id>
                            <phase>validate</phase>
                            <goals><goal>exec</goal></goals>
                            <configuration>
                                <workingDirectory>${session.executionRootDirectory}/../typescript</workingDirectory>
                                <executable>npm</executable>
                                <arguments>
                                    <argument>run</argument>
                                    <argument>build:all</argument>
                                </arguments>
                            </configuration>
                        </execution>
                        <execution>
                            <id>refresh-render-html</id>
                            <phase>validate</phase>
                            <goals><goal>exec</goal></goals>
                            <configuration>
                                <workingDirectory>${session.executionRootDirectory}</workingDirectory>
                                <executable>mvn</executable>
                                <arguments>
                                    <argument>-q</argument>
                                    <argument>-pl</argument>
                                    <argument>pathland-view-core,pathland-render-html</argument>
                                    <argument>process-resources</argument>
                                </arguments>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </build>
    </profile>
    </profiles>
</project>