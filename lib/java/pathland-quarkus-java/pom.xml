<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.pathland</groupId>
        <artifactId>pathland-parent</artifactId>
        <version>0.1.5</version>
    </parent>

    <artifactId>pathland-quarkus-java</artifactId>
    <packaging>jar</packaging>

    <name>Pathland Quarkus - Java DSL</name>
    <description>
        Java authoring DSL extension for Pathland on Quarkus. Depends on the DSL-neutral
        pathland-quarkus extension and adds pathland-view. This extension is transitional
        while the Kotlin DSL becomes the primary JVM authoring surface.
    </description>

    <dependencies>
        <dependency>
            <groupId>dev.pathland</groupId>
            <artifactId>pathland-quarkus</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>dev.pathland</groupId>
            <artifactId>pathland-view</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>io.quarkus</groupId>
                <artifactId>quarkus-extension-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>extension-descriptor</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <capabilities>
                        <provides>dev.pathland.quarkus.java</provides>
                    </capabilities>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
