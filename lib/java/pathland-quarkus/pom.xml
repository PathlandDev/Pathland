<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.pathland</groupId>
        <artifactId>pathland-parent</artifactId>
        <version>0.1.5</version>
    </parent>

    <artifactId>pathland-quarkus</artifactId>
    <packaging>jar</packaging>

    <name>Pathland Quarkus</name>
    <description>
        DSL-neutral Quarkus extension for Pathland: SSR at any path, live 16-byte opcode
        deltas over /ws, per-session state. Add this extension and a PathlandApp bean and
        you have a running app. Author the root view with pathland-view (Java) or
        pathland-view-kotlin (Kotlin).
    </description>

    <dependencies>
        <dependency>
            <groupId>dev.pathland</groupId>
            <artifactId>pathland-server-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>dev.pathland</groupId>
            <artifactId>pathland-observability</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-websockets-next</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-micrometer</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-smallrye-health</artifactId>
        </dependency>
        <!-- The OTel API is referenced only to build the optional tracing decorator; a
             Tracer bean exists only when the app adds quarkus-opentelemetry. -->
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- A registry backend so /q/metrics exists in the starter's tests. -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-micrometer-registry-prometheus</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- The runtime integration is DSL-neutral. The Java tests still author their
             fixture view through the Java DSL; production consumers bring their own
             authoring DSL (pathland-view or pathland-view-kotlin). -->
        <dependency>
            <groupId>dev.pathland</groupId>
            <artifactId>pathland-view</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>dev.pathland</groupId>
            <artifactId>pathland-test-kit</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>io.quarkus</groupId>
                <artifactId>quarkus-extension-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>extension-descriptor</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <capabilities>
                        <provides>dev.pathland.quarkus</provides>
                    </capabilities>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
