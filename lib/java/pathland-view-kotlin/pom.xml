<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.pathland</groupId>
        <artifactId>pathland-parent</artifactId>
        <version>0.1.5</version>
    </parent>

    <artifactId>pathland-view-kotlin</artifactId>
    <packaging>jar</packaging>

    <name>Pathland View Kotlin</name>
    <description>
        Idiomatic Kotlin authoring surface for Pathland: SwiftUI-shaped view builders
        (Text("…"), VStack(spacing = 8) { … }, Button("Save") { … }), modifier sugar
        (.padding(16), .frame(width = …)), Kotlin signal conveniences, property-delegate
        State, navigation, and media helpers. Kotlin-owned views and modifiers over
        pathland-view-core; Kotlin trees emit byte-identical opcodes to the Java DSL.
    </description>

    <dependencies>
        <dependency>
            <groupId>dev.pathland</groupId>
            <artifactId>pathland-view-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-stdlib</artifactId>
            <version>${kotlin.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Parity tests compare Kotlin-owned views with the Java DSL. -->
        <dependency>
            <groupId>dev.pathland</groupId>
            <artifactId>pathland-view</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <sourceDirectory>${project.basedir}/src/main/kotlin</sourceDirectory>
        <testSourceDirectory>${project.basedir}/src/test/kotlin</testSourceDirectory>
        <plugins>
            <plugin>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-maven-plugin</artifactId>
                <version>${kotlin.version}</version>
                <executions>
                    <execution>
                        <id>compile</id>
                        <phase>process-sources</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>test-compile</id>
                        <phase>process-test-sources</phase>
                        <goals>
                            <goal>test-compile</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <jvmTarget>${maven.compiler.release}</jvmTarget>
                    <languageVersion>2.4</languageVersion>
                    <apiVersion>2.4</apiVersion>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>-Djava.library.path=${project.basedir}/../../rust/target/debug</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
