<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.pathland</groupId>
        <artifactId>pathland-parent</artifactId>
        <version>0.1.5</version>
    </parent>

    <artifactId>pathland-qt-demo</artifactId>
    <packaging>jar</packaging>

    <!-- Demo application — not published to Maven Central. -->
    <properties>
        <maven.deploy.skip>true</maven.deploy.skip>
        <maven.javadoc.skip>true</maven.javadoc.skip>
    </properties>

    <name>Pathland Qt Desktop Demo</name>
    <description>
        Runs the Kotlin MusicPlayerView (dev.pathland.demo.music, an Apple
        Music-style player with app-driven media) under the Qt Quick renderer
        (libpathland_qt). The Kotlin DSL emits opcodes into the libpathland_core
        shared ring (RingOpcodeSink); pathland_qt_run_ring pumps the same ring in
        place (zero-copy); native inputs round-trip as EVENT opcodes that this
        Kotlin host drains and dispatches into the app's bindings.
    </description>

    <dependencies>
        <dependency>
            <groupId>dev.pathland</groupId>
            <artifactId>pathland-demo-views-kotlin</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>dev.pathland</groupId>
            <artifactId>pathland-demo-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>net.java.dev.jna</groupId>
            <artifactId>jna</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-stdlib</artifactId>
            <version>${kotlin.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <sourceDirectory>${project.basedir}/src/main/kotlin</sourceDirectory>
        <testSourceDirectory>${project.basedir}/src/test/kotlin</testSourceDirectory>
        <plugins>
            <plugin>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-maven-plugin</artifactId>
                <version>${kotlin.version}</version>
                <executions>
                    <execution>
                        <id>compile</id>
                        <phase>process-sources</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>test-compile</id>
                        <phase>process-test-sources</phase>
                        <goals>
                            <goal>test-compile</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <jvmTarget>${maven.compiler.release}</jvmTarget>
                    <languageVersion>2.4</languageVersion>
                    <apiVersion>2.4</apiVersion>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version>
                <configuration>
                    <mainClass>dev.pathland.demo.qt.QtHost</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
