<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.pathland</groupId>
        <artifactId>pathland-parent</artifactId>
        <version>0.1.5</version>
    </parent>

    <artifactId>pathland-view-core</artifactId>
    <packaging>jar</packaging>

    <name>Pathland View</name>
    <description>
        The Pathland JVM engine, runtime and authoring DSL, written in Kotlin: the
        16-byte opcode protocol, retained-tree diff emitter, Angular-style signals,
        wire codec, router, state, lazy JNA ring interop, and the SwiftUI-shaped
        `dev.pathland.view.dsl` builders/modifiers every JVM host mounts. All server
        runtimes depend on this module. Runs on every LTS from Java 17.
    </description>

    <dependencies>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-stdlib</artifactId>
            <version>${kotlin.version}</version>
        </dependency>
        <dependency>
            <groupId>net.java.dev.jna</groupId>
            <artifactId>jna</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-maven-plugin</artifactId>
                <version>${kotlin.version}</version>
                <executions>
                    <execution>
                        <id>compile</id>
                        <phase>process-sources</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                        <configuration>
                            <sourceDirs>
                                <sourceDir>${project.basedir}/src/main/kotlin</sourceDir>
                                <sourceDir>${project.basedir}/src/main/java</sourceDir>
                            </sourceDirs>
                        </configuration>
                    </execution>
                    <execution>
                        <id>test-compile</id>
                        <phase>process-test-sources</phase>
                        <goals>
                            <goal>test-compile</goal>
                        </goals>
                        <configuration>
                            <sourceDirs>
                                <sourceDir>${project.basedir}/src/test/kotlin</sourceDir>
                                <sourceDir>${project.basedir}/src/test/java</sourceDir>
                            </sourceDirs>
                        </configuration>
                    </execution>
                </executions>
                <configuration>
                    <jvmTarget>${maven.compiler.release}</jvmTarget>
                    <languageVersion>2.4</languageVersion>
                    <apiVersion>2.4</apiVersion>
                    <args>
                        <arg>-Xjvm-default=all</arg>
                    </args>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Point the test JVM at the Rust cdylibs for JNA ring and
                         Markdown tests. -->
                    <argLine>-Djava.library.path=${project.basedir}/../../rust/target/debug</argLine>
                </configuration>
            </plugin>

            <!-- Embed the Rust inline-Markdown cdylib so `Text(...)` auto-parsing
                 travels with the view-core artifact (JNA extracts it at runtime).
                 A release build stages per-platform libs under target/native;
                 a local build embeds the host Rust debug build. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <executions>
                    <execution>
                        <id>embed-native-markdown</id>
                        <phase>process-resources</phase>
                        <configuration>
                            <target>
                                <condition property="pathland.native.ext" value=".dylib">
                                    <os family="mac" />
                                </condition>
                                <condition property="pathland.native.ext" value=".dll">
                                    <os family="windows" />
                                </condition>
                                <condition property="pathland.native.ext" value=".so">
                                    <os family="unix" />
                                </condition>
                                <property name="pathland.native.ext" value="" />

                                <property name="pathland.native.staging" value="${project.basedir}/target/native" />
                                <available file="${pathland.native.staging}" type="dir" property="pathland.native.staged" />
                                <property name="pathland.native.host" value="${project.basedir}/../../rust/target/debug/libpathland_markdown${pathland.native.ext}" />
                                <available file="${pathland.native.host}" property="pathland.native.host.present" />

                                <fail message="No Rust markdown library to embed: neither per-platform libs at ${pathland.native.staging}/&lt;os&gt;-&lt;arch&gt;/ (release) nor the host build at ${pathland.native.host} (local). Build it first: cargo build -p pathland-markdown-capi (in lib/rust).">
                                    <condition>
                                        <and>
                                            <not><isset property="pathland.native.staged" /></not>
                                            <not><isset property="pathland.native.host.present" /></not>
                                        </and>
                                    </condition>
                                </fail>

                                <mkdir dir="${project.build.outputDirectory}/META-INF/native" />
                                <copy todir="${project.build.outputDirectory}/META-INF/native">
                                    <fileset dir="${pathland.native.staging}" includes="*/*" erroronmissingdir="false" />
                                </copy>
                                <copy file="${pathland.native.host}"
                                      tofile="${project.build.outputDirectory}/META-INF/native/libpathland_markdown${pathland.native.ext}"
                                      failonerror="false" />
                            </target>
                        </configuration>
                        <goals>
                            <goal>run</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
