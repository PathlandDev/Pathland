{
  "control.background": {
    "$value": "{base.color.white}",
    "$type": "color",
    "$extensions": { "pathland": { "dark": "{base.color.white-a10}" } }
  },
  "control.foreground": {
    "$value": "{base.color.gray.900}",
    "$type": "color",
    "$extensions": { "pathland": { "dark": "{base.color.gray.50}" } }
  },
  "control.border": {
    "$value": "{base.color.gray.300}",
    "$type": "color",
    "$extensions": { "pathland": { "dark": "{base.color.white-a15}" } }
  },
  "control.border.width": { "$value": "{base.border.width.1}", "$type": "dimension" },
  "control.radius": { "$value": "{base.radius.sm}", "$type": "dimension" },
  "control.height": { "$value": "{base.size.control.md}", "$type": "dimension" },
  "control.padding.horizontal": { "$value": "{base.space.3}", "$type": "dimension" },
  "control.padding.vertical": { "$value": "{base.space.1_5}", "$type": "dimension" },
  "control.font.size": { "$value": "{base.font.size.14}", "$type": "dimension" },
  "control.font.weight": { "$value": "{base.font.weight.600}", "$type": "number" },
  "control.accent": {
    "$value": "{base.color.blue.600}",
    "$type": "color",
    "$extensions": { "pathland": { "dark": "{base.color.blue.400}" } }
  },

  "control.background.hover": {
    "$value": "{base.color.gray.50}",
    "$type": "color",
    "$extensions": {
      "pathland": { "dark": "{base.color.white-a20}", "internal": true }
    }
  },
  "control.thumb": {
    "$value": "{base.color.white}",
    "$type": "color",
    "$extensions": {
      "pathland": { "dark": "{base.color.gray.50}", "internal": true }
    }
  },
  "control.line-height": {
    "$value": "{base.space.6}",
    "$type": "dimension",
    "$extensions": { "pathland": { "internal": true } }
  },
  "control.focus.ring.width": {
    "$value": "{base.border.width.2}",
    "$type": "dimension",
    "$extensions": { "pathland": { "internal": true } }
  },
  "control.focus.ring.offset": {
    "$value": "{base.border.width.2}",
    "$type": "dimension",
    "$extensions": { "pathland": { "internal": true } }
  },
  "control.focus.ring.inset": {
    "$value": "{base.size.focus-inset}",
    "$type": "dimension",
    "$extensions": { "pathland": { "internal": true } }
  },
  "control.swatch.inset": {
    "$value": "{base.size.swatch-inset}",
    "$type": "dimension",
    "$extensions": { "pathland": { "internal": true } }
  },
  "control.transition.duration": {
    "$value": "{base.duration.120}",
    "$type": "duration",
    "$extensions": { "pathland": { "internal": true } }
  },
  "control.icon.size": {
    "$value": "{base.size.icon}",
    "$type": "dimension",
    "$extensions": { "pathland": { "internal": true } }
  },
  "control.icon.offset": {
    "$value": "{base.size.icon-offset}",
    "$type": "dimension",
    "$extensions": { "pathland": { "internal": true } }
  }
}
